#!/bin/sh
# Conformance against toml-test (design section 15). Run from the package
# root; needs network access and R >= 4.5.
#
#   tools/run-conformance --fixtures-only
#       The committed suite in tests/testthat/toml-test/ must equal a fresh
#       fetch at the pinned tag (tools/update-fixtures).
#
#   tools/run-conformance
#       Also runs every case, for TOML 1.0.0 and 1.1.0, through the current
#       check phase (tools/conformance.R): every valid case must be accepted.
set -eu

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

tools/update-fixtures "$WORK/toml-test" > /dev/null
if diff -r "$WORK/toml-test" tests/testthat/toml-test > /dev/null; then
  echo "==> tests/testthat/toml-test matches toml-test $(head -1 "$WORK/toml-test/VERSION")"
else
  echo "FAIL: tests/testthat/toml-test differs from a fresh fetch" >&2
  diff -rq "$WORK/toml-test" tests/testthat/toml-test >&2 || true
  exit 1
fi

[ "${1:-}" = --fixtures-only ] && exit 0

fail=0
for v in 1.0.0 1.1.0; do
  echo
  Rscript tools/conformance.R "$v" || fail=1
done
exit $fail
